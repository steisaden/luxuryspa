<div data-copy-prompt>
  <div class="prompt-block__heading">
    <h2>Reconstruction prompt</h2>
    <button class="copy-button" type="button" data-copy-button data-copy-default="Copy prompt">Copy prompt</button>
  </div>
  <pre class="prompt-source" data-copy-source tabindex="0" aria-label="Reconstruction prompt">{{ prompt }}</pre>
  <p class="copy-status" data-copy-status role="status" aria-live="polite">Select and copy manually if clipboard access is unavailable.</p>
</div>

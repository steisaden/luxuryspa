{
  "name": "the-exhale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/server.ts\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:pages": "npm run build && tsx scripts/export-pages.ts",
    "start": "node dist/server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.2",
    "@fastify/view": "^12.0.0",
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource/bellefair": "^5.3.0",
    "fastify": "^5.10.0",
    "gsap": "^3.15.0",
    "htmx.org": "^2.0.10",
    "lenis": "^1.3.25",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/nunjucks": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
